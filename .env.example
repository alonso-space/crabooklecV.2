DB_NAME=db-crabook
DB_USER=crabook
DB_PASSWORD=cambiar
# Solo la usa el contenedor db; distinta de DB_PASSWORD
DB_ROOT_PASSWORD=cambiar

# Firma las sesiones. Generar con: openssl rand -hex 32
AUTH_SECRET=cambiar_por_algo_de_32_o_mas_caracteres
# true solo con HTTPS (tailscale serve); con HTTP la sesión no se mantiene
COOKIE_SEGURA=false

APP_PORT=8085
# 127.0.0.1 = solo esta máquina; 0.0.0.0 = toda la red (evitar)
BIND_ADDRESS=127.0.0.1

# Para Docker/Linux: local (archivo/dispositivo) o red (TCP).
# Para el ejecutable CRAbook en Windows: usb y el nombre de Windows.
IMPRESORA_TIPO=local
# local: Ej. /dev/usb/lp2 (Linux)
IMPRESORA_DESTINO=
# Solo Electron/Windows con IMPRESORA_TIPO=usb: nombre exacto de Get-Printer
IMPRESORA_NOMBRE=
# GID del dispositivo: stat -c '%g' /dev/usb/lp2
IMPRESORA_GID=
# 2 = CP850 (tildes y ñ)
IMPRESORA_CODEPAGE=2
# true = quita tildes si el codepage no cuadra
IMPRESORA_SIN_TILDES=false