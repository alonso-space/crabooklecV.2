{
  "name": "crabook",
  "version": "2.0.0",
  "description": "CRAbook - biblioteca CRA",
  "author": "Rohus Suazo",
  "type": "module",
  "main": "electron/main.js",
  "scripts": {
    "instalar": "npm install && cd client && npm install",
    "build:client": "cd client && npm run build",
    "start": "npm run build:client && electron .",
    "dist": "npm run build:client && electron-builder --win"
  },
  "dependencies": {
    "express": "^5.2.1",
    "knex": "^3.3.0",
    "mysql": "^2.18.1"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "cl.crabook.app",
    "productName": "CRAbook",
    "asar": false,
    "files": [
      "electron/**",
      "server/**",
      "client/dist/**",
      "!server/node_modules/**",
      "!server/.env*",
      "!server/.auth-secret",
      "!**/.env*",
      "!**/*.md"
    ],
    "win": {
      "target": ["nsis", "portable"],
      "icon": "client/public/img/logo.png"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true
    }
  }
}
